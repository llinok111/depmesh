{
	"root": true,
	"extends": "eslint:recommended",
	"env": {
		"node": true,
		"es2022": true,
		"mocha": false
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "script"
	},
	"ignorePatterns": ["test-depmesh/fixtures/**"],
	"rules": {
		"no-unused-vars": ["error", {"args": "after-used", "caughtErrors": "none"}],
		"no-empty": ["error", {"allowEmptyCatch": true}],
		"no-console": "off"
	}
}
