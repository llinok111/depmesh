{
  "name": "depmesh",
  "version": "1.0.0",
  "author": "Patrik Henningsson <patrik.henningsson@gmail.com> (upstream madge); depmesh layer by llinok111",
  "repository": "git+ssh://git@github.com/llinok111/depmesh.git",
  "homepage": "https://llinok111.github.io/depmesh/",
  "license": "MIT",
  "reveal": true,
  "description": "Dependency analysis and interactive graph workbench for real module graphs (built on madge)",
  "keywords": [
    "AMD",
    "ES6",
    "ES7",
    "RequireJS",
    "circular",
    "cycle-detection",
    "dependencies",
    "dependency",
    "dependency-analysis",
    "graph",
    "graphviz",
    "impact-analysis",
    "interactive-graph",
    "module",
    "require",
    "scc"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./lib/depmesh",
  "exports": {
    ".": "./lib/depmesh/index.js",
    "./coverage": "./lib/depmesh/coverage.js",
    "./graph": "./lib/depmesh/graph.js",
    "./scan": "./lib/depmesh/scan.js",
    "./ui": "./lib/depmesh/ui.js",
    "./madge": "./lib/api.js"
  },
  "bin": {
    "madge": "./bin/cli.js",
    "depmesh": "./bin/depmesh.js"
  },
  "scripts": {
    "test": "npm run lint && npm run mocha",
    "mocha": "mocha test/*.js",
    "watch": "mocha --watch --growl test/*.js",
    "lint": "eslint bin/cli.js lib test/*.js",
    "lint:depmesh": "eslint --no-ignore --no-eslintrc -c eslint.depmesh.json \"lib/depmesh/*.js\" bin/depmesh.js \"scripts/*.js\" \"test-depmesh/*.js\"",
    "depmesh:test": "node scripts/run-tests.js",
    "depmesh:build": "node bin/depmesh.js build samples/vue-core/packages --tsconfig samples/vue-core/tsconfig.json --ext ts --out demo/vue-core.html --deterministic --quiet",
    "depmesh:report": "node scripts/build-report.js",
    "debug": "node bin/cli.js --debug bin lib",
    "generate": "npm run generate:small && npm run generate:madge",
    "generate:small": "bin/cli.js --image /tmp/simple.svg test/cjs/circular/a.js",
    "generate:madge": "bin/cli.js --image /tmp/madge.svg bin lib",
    "test:output": "./test/output.sh",
    "release": "npm test && release-it"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.paypal.me/pahen"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^7.2.0",
    "commondir": "^1.0.1",
    "debug": "^4.3.4",
    "dependency-tree": "^11.0.0",
    "filing-cabinet": "^5.0.2",
    "ora": "^5.4.1",
    "pluralize": "^8.0.0",
    "precinct": "^12.1.1",
    "pretty-ms": "^7.0.1",
    "rc": "^1.2.8",
    "stream-to-array": "^2.3.0",
    "ts-graphviz": "^2.1.2",
    "typescript": "^5.4.5",
    "walkdir": "^0.4.1"
  },
  "devDependencies": {
    "@aptoma/eslint-config": "^7.0.1",
    "auto-changelog": "^2.4.0",
    "eslint": "^7.29.0",
    "mocha": "^9.0.1",
    "mz": "^2.7.0",
    "release-it": "^16.2.1",
    "should": "^13.2.3",
    "typescript": "^5.4.4"
  }
}
